{
    "FrontendUrl": "http://localhost:5173",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=UrlShorterDb;Username=YOUR_USER;Password=YOUR_PASSWORD",
        "Redis": "YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD"
    },
    "Jwt": {
        "Secret": "YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS",
        "Issuer": "UrlShorterAPI",
        "Audience": "UrlShorterUsers",
        "ExpireMinutes": 1440
    },
    "Email": {
        "SmtpServer": "YOUR_SMTP_SERVER",
        "SmtpPort": 1025,
        "SmtpUser": "",
        "SmtpPass": "",
        "FromName": "UrlShorter Team",
        "FromAddress": "no-reply@urlshorter.com"
    },
    "UrlSafety": {
        "Enabled": true,
        "CheckTimeoutSeconds": 5,
        "GoogleSafeBrowsing": {
            "Enabled": true,
            "ApiKey": "SUA_API_KEY_AQUI"
        },
        "SpamHausDbl": {
            "Enabled": true
        },
        "Surbl": {
            "Enabled": true
        }
    },
    "BlockedShorteners": {
        "Domains": [
            "bit.ly", "tinyurl.com", "t.co", "goo.gl", "ow.ly", "is.gd",
            "buff.ly", "cutt.ly", "rebrand.ly", "shorturl.at", "rb.gy",
            "dw.gd", "v.gd", "tny.im", "tiny.cc", "clck.ru", "surl.li",
            "urlshortn.com", "shorter.me", "shorturl.do", "shorte.st",
            "shrinkme.io", "cut.ly", "bitly.com", "bl.ink",
            "wa.me", "t.me",
            "0link.co", "adf.ly", "bc.vc", "ouo.io", "tiny.pl",
            "krz.ch", "href.li",
            "jadsondev.com.br"
        ]
    },
    "DataCleanup": {
        "ClickLogRetentionDays": 365,
        "ExpiredUrlRetentionDays": 30
    }
}