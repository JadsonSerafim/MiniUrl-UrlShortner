{
    "FrontendUrl": "http://localhost:5173",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Host=YOUR_POSTGRES_HOST;Port=5432;Database=UrlShorterDb;Username=YOUR_USER;Password=YOUR_PASSWORD",
        "Redis": "YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD"
    },
    "Redis": {
        "ConnectionString": "YOUR_REDIS_HOST:6379,user=default,password=YOUR_REDIS_PASSWORD"
    },
    "Jwt": {
        "Secret": "YOUR_SUPER_SECRET_JWT_KEY_MIN_32_CHARS",
        "Issuer": "UrlShorterAPI",
        "Audience": "UrlShorterUsers",
        "ExpireMinutes": 1440
    },
    "Email": {
        "SmtpServer": "YOUR_SMTP_SERVER",
        "SmtpPort": 1025,
        "SmtpUser": "",
        "SmtpPass": "",
        "FromName": "UrlShorter Team",
        "FromAddress": "no-reply@urlshorter.com"
    }
}